---
import type { Post } from "~/types";
import { formatDate } from "~/utils";
import PostCategory from "./PostCategory.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { translate: t } = Astro.locals;

const categoryList = post.data.categories ?? [];
---

<header flex="~ col gap-2">
  <h1 class="post-title">
    <a
      class="not-prose"
      href={`/posts/${post.data.pubDate?.getFullYear()}/${String(post.data.pubDate?.getMonth() + 1).padStart(2, "0")}/${post.id}/`}
    >
      {post.data.title}
    </a>
  </h1>
  <div class="text-3.5">
    <span class="mx-1">
      {t(post.data.modDate ? "updated_at" : "posted_at")}
    </span>
    <time>{formatDate(post.data.modDate ?? post.data.pubDate)}</time>
    <span class="mx-2">|</span>
    {categoryList.map((category) => (
      <PostCategory category={category} />
    ))}
  </div>
</header>
