---
import { themeConfig } from "~/.config";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteNavigation from "~/components/SiteNavigation.astro";
import SiteTitle from "~/components/SiteTitle.astro";
import SiteSeo from "~/components/SiteSeo.astro";
import LaTeX from "~/components/LaTeX.astro";
import Analytics from "~/components/Analytics.astro";
import ThemeScript from "~/components/ThemeScript.astro";
import "~/styles/global.css";
import type { MarkdownHeading } from "astro";
import TOC from "~/components/TOC.astro";

const lang = themeConfig.appearance.locale ?? "en-us";
const dark = themeConfig.appearance.theme === "dark";

interface Props {
  headings?: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<html lang={lang} class:list={["animation-prepared", { dark }]}>
  <head>
    <slot name="seo">
      {" "}
      <SiteSeo />{" "}
    </slot>
    <LaTeX />
    <Analytics />
    <!-- <ThemeScript /> -->
  </head>

  <body
    p="7.5 lg:(y-0 x-15)"
    lg="grid gap-x-6 cols-[1fr_12rem] rows-[1fr_9rem]"
  >
    <header class="transition-swup-header">
      <div
        class="sticky top-0 z-10 flex flex-col gap-2.5 lg:gap-10 overflow-hidden h-100%"
        m="7.5 pt-20 lg:(x-0 t-20 b-4) h-80vh"
        lg="row-1-2 pt-20 col-2-3 items-start h-80vh"
      >
        <SiteTitle />
        <SiteNavigation />
        <div id="toc-container" class="transition-swup-main">
          {
            headings && headings.length > 0 ? (
              <div
                class="mt-auto overflow-y-auto hidden max-h-full min-h-0"
                m="block"
                lg="block"
              >
                <TOC headings={headings} />
              </div>
            ) : (
              <div class="hidden m-0" m="block" lg="block">
                <div class="flex flex-col items-center rounded-2xl border border-primary border-dashed py-2 text-center w-40">
                  <div class="relative flex h-28 w-28 shrink-0 items-center justify-center rounded-full bg-yellow-300/10 ring-2 ring-amber-300/70 shadow-[0_0_34px_-10px_rgba(250,204,21,0.55)]">
                    <a
                      href={`https://github.com/kazutoiris`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="not-underline-hover"
                    >
                      <img
                        src="https://avatars.githubusercontent.com/u/78157415?v=4"
                        alt="kazutoiris"
                        class="relative h-20 w-20 rounded-full object-cover avatar-spin"
                      />
                    </a>
                  </div>

                  <a
                    href="https://ghfind.com/u/kazutoiris"
                    class="decoration-none not-underline-hover"
                  >
                    {" "}
                    <div class="mt-4 tabular-nums">
                      <span class="text-xl font-black bg-gradient-to-b from-amber-300 via-yellow-500 to-amber-700 bg-clip-text text-transparent">
                        80.70
                      </span>
                      <span class="text-xs">/100</span>
                    </div>
                  </a>
                  <div class="mt-1 text-xl font-bold text-amber-600">
                    🥇 顶级
                  </div>
                  <div class="mt-1 text-sm font-medium text-primary">
                    顶级开发者 · 一线水准
                  </div>

                  <div class="flex flex-wrap items-center justify-center gap-1.5">
                    <a
                      href={`https://github.com/apache`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full px-2.5 py-0.5 text-xs decoration-none"
                    >
                      @apache
                    </a>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </header>

    <main
      class="transition-swup-main scrollbar-hide outline-none"
      lg="row-1-3 col-1-2 py-10 "
    >
      <slot />
    </main>

    <footer class="transition-swup-footer py-7.5" lg="row-2-3 col-2-3">
      <SiteFooter />
    </footer>

    <script>
      document.addEventListener("animationend", removeAnimation, false);
      function removeAnimation() {
        document.documentElement.classList.remove("animation-prepared");
        document.removeEventListener("animationend", removeAnimation, false);
      }
    </script>
    <style>
      /* 页面首次加载动画 */
      html.animation-prepared .transition-swup-header,
      html.animation-prepared .transition-swup-footer {
        animation: fade-in-down 1s linear 1;
        --at-apply: "lg-animate-name-fade-in-left";
      }

      html.animation-prepared .transition-swup-main {
        animation: fade-in-down 1s linear 1;
      }

      @keyframes fade-in-down {
        0% {
          transform: translateY(-1rem);
          opacity: 0;
        }
        100% {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @keyframes fade-in-left {
        0% {
          opacity: 0;
          transform: translateX(1rem);
        }

        100% {
          opacity: 1;
          transform: translateX(0);
        }
      }

      /* 页面过渡动画 */
      html.is-animating .transition-swup-main {
        opacity: 0;
        transform: translateY(-1rem);
      }
      html.is-leaving .transition-swup-main {
        opacity: 0;
        transform: translateY(1rem);
      }
      .transition-swup-main {
        transition-duration: 0.5s;
        transition-timing-function: linear;
        transform: translateY(0);
        opacity: 1;
      }

      .avatar-spin {
        transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;
        cursor: pointer;
      }

      .avatar-spin:hover {
        /* 上浮 6px + 正向旋转 360° */
        transform: rotate(360deg);
      }
    </style>
  </body>
</html>
